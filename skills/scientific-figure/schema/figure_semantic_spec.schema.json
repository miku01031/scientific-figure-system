                },
                "series_id": {
                  "type": "string"
                }
              },
              "required": [
                "axis",
                "value",
                "meaning",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "axis": {
                  "enum": [
                    "x",
                    "y"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "meaning": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "reference",
                    "threshold",
                    "fault",
                    "validity",
                    "alarm"
                  ]
                },
                "series_id": {
                  "type": "string"
                }
              },
              "required": [
                "axis",
                "value",
                "meaning",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "invalid_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "axis": {
                  "enum": [
                    "x",
                    "y"
                  ]
                },
                "start": {
                  "type": "number"
                },
                "end": {
                  "type": "number"
                },
                "meaning": {
                  "type": "string"
                }
              },
              "required": [
                "axis",
                "start",
                "end",
                "meaning"
              ],
              "additionalProperties": false
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "series_id": {
                  "type": "string"
                },
                "point_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "text",
                "series_id",
                "point_index"
              ],
              "additionalProperties": false
            }
          },
          "panel_label": {
            "type": "string"
          },
          "visual_factors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "panel_id",
          "title",
          "domain",
          "x_axis",
          "y_axis",
          "series"
        ],
        "additionalProperties": false
      }
